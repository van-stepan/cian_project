# Halyk Market merchant API credentials.
# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Either set the full client id...
HALYK_CLIENT_ID=HMM_000000000000
# ...or set just the 12-digit BIN/IIN and let the code build HMM_<bin>.
#HALYK_BIN=000000000000

# Arrives by email from api-noreply@halykmarket.com when the API is enabled
# or when a password reset is requested.
HALYK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# prod | test
HALYK_ENV=prod

# Optional overrides, only needed if Halyk moves the endpoints.
# gw_base issues tokens and serves order listing/detail; api_base serves order
# state changes and the JSON:API relationship reads.
#HALYK_GW_BASE=https://halykmarket.kz/gw
#HALYK_API_BASE=https://api.halykmarket.com
